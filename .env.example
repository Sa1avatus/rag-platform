RAG_ENV=development
RAG_DATABASE_URL=postgresql+asyncpg://rag:rag-local-password@rag-postgres:5432/rag
RAG_REDIS_URL=redis://rag-redis:6379/0
RAG_OPENSEARCH_URL=http://rag-opensearch:9200
RAG_MINIO_ENDPOINT=rag-minio:9000
RAG_MINIO_ACCESS_KEY=rag-local-access
RAG_MINIO_SECRET_KEY=change-me
RAG_MINIO_BUCKET=rag-documents
RAG_ADMIN_TOKEN=local-rag-admin-token
RAG_API_KEY_PEPPER=change-me-too
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_REVISION=default
RAG_EMBEDDING_NORMALIZATION=l2
RAG_PARSER_VERSION=text-v1
RAG_CHUNKER_VERSION=word-window-v1
RAG_CHUNK_STRATEGY=recursive
RAG_CHUNK_SIZE_WORDS=330
RAG_CHUNK_OVERLAP_WORDS=45
RAG_CHUNK_MIN_WORDS=20
RAG_INDEX_VERSION=rag-chunks-v1
RAG_QUERY_EMBEDDING_TIMEOUT_SECONDS=30
RAG_QUERY_EMBEDDING_CACHE_ENABLED=true
RAG_QUERY_EMBEDDING_CACHE_TTL_SECONDS=3600
RAG_CACHE_NAMESPACE=rag:cache:v1
RERANKER_BASE_URL=http://reranker-service:8200
RERANKER_API_KEY=replace-with-reranker-service-key
RERANKER_TIMEOUT_SECONDS=8
RAG_RERANKER_MAX_RETRIES=1
RERANKER_ENABLED=true
RAG_OTEL_ENDPOINT=
